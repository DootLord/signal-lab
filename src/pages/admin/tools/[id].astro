---
import Base from '../../../layouts/Base.astro';
import ToolForm from '../../../components/ToolForm.astro';
import KindBadge from '../../../components/KindBadge.astro';
import ToolLogo from '../../../components/ToolLogo.astro';
import { deleteTool, getLogoInfo, getToolById, setStatus, updateTool, type ToolInput } from '../../../lib/db.ts';
import { refreshLogo } from '../../../lib/logos.ts';
import { host, timeAgo } from '../../../lib/format.ts';
import { parseToolForm } from '../../../lib/forms.ts';
import { ArrowUpRight, CircleCheck, ImageIcon, Radar, RefreshCw, ThumbsDown, ThumbsUp, Trash } from '../../../components/icons.ts';

const id = Number(Astro.params.id);
let tool = Number.isInteger(id) ? getToolById(id) : undefined;
if (!tool) return new Response(null, { status: 404, statusText: 'Not found' });

let errors: string[] = [];
let value: Partial<ToolInput> = tool;
let saved = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const back = String(form.get('back') ?? '');
  const returnTo = back === '/admin' ? '/admin' : `/admin/tools/${id}`;
  if (action === 'publish' || action === 'reject' || action === 'unpublish') {
    setStatus(id, action === 'publish' ? 'published' : action === 'reject' ? 'rejected' : 'pending');
    return Astro.redirect(returnTo, 303);
  }
  if (action === 'delete') {
    deleteTool(id);
    return Astro.redirect('/admin', 303);
  }
  if (action === 'logo') {
    await refreshLogo(id);
    tool = getToolById(id)!;
    value = tool;
  }
  if (action === 'save') {
    const result = parseToolForm(form);
    if (result.ok) {
      const before = tool;
      tool = updateTool(id, result.value)!;
      // A new link may mean a different logo.
      if (before.website !== tool.website || before.repo !== tool.repo || before.logoUrl !== tool.logoUrl) {
        await refreshLogo(id);
        tool = getToolById(id)!;
      }
      value = tool;
      saved = true;
    } else {
      errors = result.errors;
      value = result.value;
    }
  }
}
const logoInfo = getLogoInfo(id);
const status = {
  published: { label: 'Published', cls: 'new' },
  pending: { label: 'Waiting for review', cls: 'accent' },
  rejected: { label: 'Rejected', cls: 'danger' },
}[tool.status];
---
<Base title={`Edit ${tool.name}`} nav="admin" crumbs={[{ label: 'Admin', href: '/admin' }, { label: tool.name }]}>
  <div style="max-width:880px">
    <header class="tool-hero" style="margin-bottom:20px;padding-bottom:20px">
      <ToolLogo tool={tool} size={56} eager />
      <div class="tool-hero-main">
        <div class="badges"><span class={`badge ${status.cls}`}>{status.label}</span><KindBadge kind={tool.kind} /></div>
        <h1>{tool.name}</h1>
        <div class="tool-hero-actions">
          {tool.status !== 'published' && (
            <form method="post"><input type="hidden" name="_action" value="publish" /><button class="btn primary"><CircleCheck size={16} /> Publish</button></form>
          )}
          {tool.status === 'published' && (
            <>
              <a class="btn" href={`/tools/${tool.slug}`}>View public page <ArrowUpRight size={15} /></a>
              <form method="post"><input type="hidden" name="_action" value="unpublish" /><button class="btn">Unpublish</button></form>
            </>
          )}
          {tool.status !== 'rejected' && (
            <form method="post"><input type="hidden" name="_action" value="reject" /><button class="btn">Reject</button></form>
          )}
          <form method="post" onsubmit="return confirm('Delete this tool permanently? Rejecting keeps it out of future scans; deleting does not.')">
            <input type="hidden" name="_action" value="delete" /><button class="btn danger"><Trash size={15} /> Delete</button>
          </form>
        </div>
      </div>
    </header>

    {saved && <div class="alert success" role="status"><CircleCheck size={16} /> Changes saved.</div>}
    {tool.foundNote && (
      <div class="alert info">
        <Radar size={16} />
        <span><strong>Why the scanner suggested this:</strong> {tool.foundNote}{tool.foundVia && <> · <a class="link" href={tool.foundVia} rel="noopener" target="_blank">source</a></>}</span>
      </div>
    )}

    <div class="alert info logo-status">
      <ImageIcon size={16} />
      <span>
        {logoInfo?.found
          ? <>Logo from <a class="link" href={logoInfo.source!} rel="noopener" target="_blank">{host(logoInfo.source!)}</a>, checked {timeAgo(logoInfo.fetched_at)}.</>
          : logoInfo
            ? <>No logo found ({logoInfo.error}), so the monogram is shown. Paste a <b>Logo image URL</b> below to set one.</>
            : <>Looking for a logo in the background.</>}
        {' '}<span class="muted"><ThumbsUp size={13} /> {tool.votes.up} · <ThumbsDown size={13} /> {tool.votes.down}</span>
      </span>
      <form method="post" style="margin-left:auto"><input type="hidden" name="_action" value="logo" /><button class="btn sm"><RefreshCw size={14} /> Refetch logo</button></form>
    </div>

    <ToolForm value={value} errors={errors} submitLabel="Save changes" />
  </div>
</Base>
