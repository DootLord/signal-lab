---
import Base from '../../../layouts/Base.astro';
import ToolForm from '../../../components/ToolForm.astro';
import KindBadge from '../../../components/KindBadge.astro';
import { deleteTool, getToolById, setStatus, updateTool, type ToolInput } from '../../../lib/db.ts';
import { parseToolForm } from '../../../lib/forms.ts';

const id = Number(Astro.params.id);
let tool = Number.isInteger(id) ? getToolById(id) : undefined;
if (!tool) return new Response(null, { status: 404, statusText: 'Not found' });

let errors: string[] = [];
let value: Partial<ToolInput> = tool;
let saved = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const back = String(form.get('back') ?? '');
  const returnTo = back === '/admin' ? '/admin' : `/admin/tools/${id}`;
  if (action === 'publish' || action === 'reject' || action === 'unpublish') {
    setStatus(id, action === 'publish' ? 'published' : action === 'reject' ? 'rejected' : 'pending');
    return Astro.redirect(returnTo, 303);
  }
  if (action === 'delete') {
    deleteTool(id);
    return Astro.redirect('/admin', 303);
  }
  if (action === 'save') {
    const result = parseToolForm(form);
    if (result.ok) {
      tool = updateTool(id, result.value)!;
      value = tool;
      saved = true;
    } else {
      errors = result.errors;
      value = result.value;
    }
  }
}
const statusLabel = { published: 'Published', pending: 'Waiting for review', rejected: 'Rejected' }[tool.status];
---
<Base title={`Edit ${tool.name}`}>
  <div class="wrap section" style="max-width:820px">
    <p class="small"><a href="/admin">← Admin</a></p>
    <h1>{tool.name} <KindBadge kind={tool.kind} /></h1>
    <p class="muted">
      {statusLabel}
      {tool.status === 'published' && <> · <a href={`/tools/${tool.slug}`}>View public page</a></>}
    </p>
    {saved && <p class="notice" role="status">Saved.</p>}
    {tool.foundNote && (
      <div class="notice">
        <strong>Why the scanner suggested this:</strong> {tool.foundNote}
        {tool.foundVia && <> (<a href={tool.foundVia} rel="noopener">found here</a>)</>}
      </div>
    )}

    <ToolForm value={value} errors={errors} submitLabel="Save changes" />

    <hr style="border:0;border-top:1px solid var(--border);margin:2rem 0" />
    <div class="btn-row">
      {tool.status !== 'published' && (
        <form method="post"><input type="hidden" name="_action" value="publish" /><button class="btn primary">Publish</button></form>
      )}
      {tool.status === 'published' && (
        <form method="post"><input type="hidden" name="_action" value="unpublish" /><button class="btn">Unpublish</button></form>
      )}
      {tool.status !== 'rejected' && (
        <form method="post"><input type="hidden" name="_action" value="reject" /><button class="btn">Reject</button></form>
      )}
      <form method="post" onsubmit="return confirm('Delete this tool permanently? Rejecting keeps it out of future scans; deleting does not.')">
        <input type="hidden" name="_action" value="delete" /><button class="btn danger">Delete</button>
      </form>
    </div>
  </div>
</Base>
