---
import Base from '../../../layouts/Base.astro';
import ToolForm from '../../../components/ToolForm.astro';
import PageHead from '../../../components/PageHead.astro';
import { createTool, type ToolInput } from '../../../lib/db.ts';
import { parseToolForm } from '../../../lib/forms.ts';
import { refreshLogo } from '../../../lib/logos.ts';

let errors: string[] = [];
let value: Partial<ToolInput> = { kind: 'gem' };
if (Astro.request.method === 'POST') {
  const result = parseToolForm(await Astro.request.formData());
  if (result.ok) {
    const tool = createTool(result.value, 'published');
    await refreshLogo(tool.id);
    return Astro.redirect(`/tools/${tool.slug}`, 303);
  }
  errors = result.errors;
  value = result.value;
}
---
<Base title="Add a tool" nav="admin" crumbs={[{ label: 'Admin', href: '/admin' }, { label: 'Add a tool' }]}>
  <div style="max-width:880px">
    <PageHead title="Add a tool" description="Tools you add here are published straight away." />
    <ToolForm value={value} errors={errors} submitLabel="Publish tool" />
  </div>
</Base>
