---
import Base from '../layouts/Base.astro';
import Empty from '../components/Empty.astro';
---
<Base title="Not found" crumbs={[{ label: 'Not found' }]}>
  <div style="max-width:560px;margin:48px auto">
    <Empty title="We couldn’t find that page" text="The page or tool doesn’t exist, or hasn’t been published yet.">
      <div class="btn-row" style="justify-content:center">
        <a class="btn primary" href="/browse">Browse tools</a>
        <a class="btn" href="/">Go home</a>
      </div>
    </Empty>
  </div>
</Base>
