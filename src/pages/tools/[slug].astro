---
import { AUTHOR, SITE_NAME, abs, breadcrumbs, clip, topicPath } from '../../lib/site.ts';
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import KindBadge from '../../components/KindBadge.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import Recommend from '../../components/Recommend.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { getPublishedBySlug, getVote, publishedSlugs, related, slugify, tagCounts } from '../../lib/db.ts';
import { voterId } from '../../lib/votes.ts';
import { formatDate, host, lines, pairs, topicLabel } from '../../lib/format.ts';
import { renderInline, renderMarkdown } from '../../lib/markdown.ts';
import {
  ArrowUpRight, BookOpen, FolderGit2, Globe, Pencil,
} from '../../components/icons.ts';

const tool = getPublishedBySlug(Astro.params.slug ?? '');
if (!tool) return new Response(null, { status: 404, statusText: 'Not found' });
const more = related(tool, 3);
const voter = voterId(Astro.cookies);
const mine = voter ? getVote(tool.id, voter) : 0;
const links = [
  tool.website && { href: tool.website, label: 'Website', Icon: Globe },
  tool.repo && { href: tool.repo, label: 'Source code', Icon: FolderGit2 },
  tool.docs && { href: tool.docs, label: 'Documentation', Icon: BookOpen },
].filter((l): l is { href: string; label: string; Icon: typeof Globe } => !!l);
const primary = links[0];

const features = pairs(tool.features);
const strengths = lines(tool.strengths);
const limitations = lines(tool.limitations);
const slugs = publishedSlugs();
const alternatives = pairs(tool.alternatives).map((a) => {
  const slug = slugify(a.title);
  return { ...a, href: a.title && slug !== tool.slug && slugs.has(slug) ? `/tools/${slug}` : null };
});
const bodyHtml = tool.body ? renderMarkdown(tool.body) : '';

const toc = [
  { id: 'overview', label: 'Overview' },
  features.length && { id: 'features', label: 'Key features' },
  bodyHtml && { id: 'in-depth', label: 'In depth' },
  (strengths.length || limitations.length) && { id: 'trade-offs', label: 'Strengths & watch-outs' },
  tool.tryIt && { id: 'try-it', label: 'Try it' },
  alternatives.length && { id: 'alternatives', label: 'Alternatives' },
].filter((x): x is { id: string; label: string } => !!x);

// Search metadata. The title leads with the tool's name and what it does, since
// that's what people search for; the description is the full summary.
const path = `/tools/${tool.slug}`;
const headline = `${tool.name}: ${tool.tagline.replace(/\.$/, '')}`;
const pageTitle = headline.length + SITE_NAME.length + 3 <= 70 ? `${headline} · ${SITE_NAME}` : headline;
const description = clip(tool.description || tool.tagline);
// The breadcrumb topic is the tool's most widely used tag, e.g. CLI rather than JSON.
const counts = new Map(tagCounts().map((t) => [t.tag, t.count]));
const mainTopic = [...tool.tags].sort((a, b) => (counts.get(b) ?? 0) - (counts.get(a) ?? 0))[0];
const trail = [
  { name: SITE_NAME, path: '/' },
  ...(mainTopic ? [{ name: topicLabel(mainTopic), path: topicPath(mainTopic) }] : [{ name: 'Browse', path: '/browse' }]),
  { name: tool.name, path },
];
const spdx = tool.license && /^[A-Za-z0-9.+-]+$/.test(tool.license) ? `https://spdx.org/licenses/${tool.license}.html` : undefined;
const schema = [
  breadcrumbs(trail),
  {
    '@type': 'WebPage',
    '@id': abs(path),
    url: abs(path),
    name: headline,
    description,
    datePublished: tool.publishedAt ?? tool.createdAt,
    dateModified: tool.updatedAt,
    isPartOf: { '@id': abs('/#website') },
    about: { '@id': abs(path) + '#software' },
    author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': abs(path) + '#software',
    name: tool.name,
    description: tool.tagline,
    applicationCategory: 'DeveloperApplication',
    url: tool.website ?? tool.repo,
    sameAs: [tool.website, tool.repo, tool.docs].filter(Boolean),
    keywords: tool.tags.join(', '),
    ...(spdx && { license: spdx }),
  },
];
---
<Base
  fullTitle={pageTitle}
  description={description}
  canonical={path}
  ogType="article"
  schema={schema}
  topic={mainTopic}
  crumbs={mainTopic ? [{ label: topicLabel(mainTopic), href: topicPath(mainTopic) }, { label: tool.name }] : [{ label: 'Browse', href: '/browse' }, { label: tool.name }]}
>
  <header class="tool-hero">
    <ToolLogo tool={tool} eager />
    <div class="tool-hero-main">
      <div class="badges">
        <KindBadge kind={tool.kind} />
      </div>
      <h1>{tool.name}</h1>
      <p class="tagline">{tool.tagline}</p>
      <div class="tool-hero-actions">
        {primary && <a class="btn primary" href={primary.href} rel="noopener" target="_blank">Visit {primary.label.toLowerCase()} <ArrowUpRight size={16} /></a>}
        {links.slice(1).map((l) => <a class="btn" href={l.href} rel="noopener" target="_blank"><l.Icon size={16} /> {l.label}</a>)}
        {Astro.locals.admin && <a class="btn ghost" href={`/admin/tools/${tool.id}`}><Pencil size={15} /> Edit</a>}
      </div>
    </div>
    <Recommend tool={tool} mine={mine} />
  </header>

  <div class="tool-layout">
    <div>
      <section class="doc" id="overview">
        <h2 class="visually-hidden">Overview</h2>
        <p class="lead">{tool.description}</p>
        {(tool.replaces || tool.useWhen) && (
          <dl class="callouts">
            {tool.replaces && <div><dt>Instead of</dt><dd>{tool.replaces}</dd></div>}
            {tool.useWhen && <div><dt>Reach for it when</dt><dd>{tool.useWhen}</dd></div>}
          </dl>
        )}
      </section>

      {features.length > 0 && (
        <section class="doc" id="features">
          <h2>Key features</h2>
          <ul class="feature-list">
            {features.map((f) => (
              <li>{f.title && <strong>{f.title}</strong>}<p set:html={renderInline(f.text)} /></li>
            ))}
          </ul>
        </section>
      )}

      {bodyHtml && (
        <section class="doc" id="in-depth">
          <h2>In depth</h2>
          <div class="prose md" set:html={bodyHtml} />
        </section>
      )}

      {(strengths.length > 0 || limitations.length > 0) && (
        <section class="doc" id="trade-offs">
          <h2 class="visually-hidden">Strengths and watch-outs</h2>
          <div class="pros-cons">
            {strengths.length > 0 && (
              <div class="pros">
                <h3>Strengths</h3>
                <ul>{strengths.map((s) => <li set:html={renderInline(s)} />)}</ul>
              </div>
            )}
            {limitations.length > 0 && (
              <div class="cons">
                <h3>Watch out for</h3>
                <ul>{limitations.map((s) => <li set:html={renderInline(s)} />)}</ul>
              </div>
            )}
          </div>
        </section>
      )}

      {tool.tryIt && (
        <section class="doc" id="try-it">
          <h2>Try it in a few minutes</h2>
          <CodeBlock code={tool.tryIt} />
        </section>
      )}

      {alternatives.length > 0 && (
        <section class="doc" id="alternatives">
          <h2>Alternatives</h2>
          <div class="alt-list">
            {alternatives.map((a) => (
              <div class="alt">
                <div class="alt-name">
                  {a.href ? <a class="link" href={a.href}>{a.title}</a> : <span>{a.title}</span>}
                  {a.href && <span class="badge accent">On Signal Lab</span>}
                </div>
                <p set:html={renderInline(a.text)} />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="aside">
      <section class="side-block">
        <h2>At a glance</h2>
        <dl class="facts">
          <div><dt>Type</dt><dd><KindBadge kind={tool.kind} /></dd></div>
          {tool.license && <div><dt>License</dt><dd>{tool.license}</dd></div>}
          {tool.language && <div><dt>Written in</dt><dd>{tool.language}</dd></div>}
          <div><dt>Added</dt><dd>{formatDate(tool.publishedAt ?? tool.createdAt)}</dd></div>
          <div><dt>Last updated</dt><dd>{formatDate(tool.updatedAt)}</dd></div>
        </dl>
      </section>
      {toc.length > 2 && (
        <nav class="side-block toc" aria-label="On this page">
          <h2>On this page</h2>
          <ul>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
        </nav>
      )}
      {links.length > 0 && (
        <section class="side-block">
          <h2>Links</h2>
          <ul class="link-list">
            {links.map((l) => (
              <li><a href={l.href} rel="noopener" target="_blank"><l.Icon size={16} /><span>{l.label}<small>{host(l.href)}</small></span><ArrowUpRight size={14} /></a></li>
            ))}
          </ul>
        </section>
      )}
      <section class="side-block">
        <h2>Topics</h2>
        <div class="tags">{tool.tags.map((tag) => <a class="tag" href={topicPath(tag)}>{tag}</a>)}</div>
      </section>
    </aside>
  </div>

  {more.length > 0 && (
    <section class="section">
      <div class="section-head"><div><h2>Related tools</h2><p>Other tools that share topics with {tool.name}.</p></div></div>
      <div class="grid">{more.map((t) => <ToolCard tool={t} />)}</div>
    </section>
  )}
</Base>
