---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { siteStats, tagCounts } from '../lib/db.ts';
import { topicLabel } from '../lib/format.ts';
import TopicIcon from '../components/TopicIcon.astro';
import {
  ChevronRight, Compass, Gem, House, Inbox, Info, LayoutGrid, Lock, Menu, Moon, Radar, Rss, Search, Sparkles, Sun, Tags,
} from '../components/icons.ts';

export type Nav = 'home' | 'browse' | 'gems' | 'new' | 'topics' | 'about' | 'admin' | 'none';
interface Props {
  title?: string;
  description?: string;
  nav?: Nav;
  topic?: string;
  crumbs?: { label: string; href?: string }[];
  query?: string;
}
const { title, description = 'Discover developer tools worth knowing: what’s new and moving, and the established gems you may have missed.', nav = 'none', topic, crumbs = [], query = '' } = Astro.props;
const fullTitle = title ? `${title} · Signal Lab` : 'Signal Lab · Developer tools worth knowing';
const canonical = new URL(Astro.url.pathname + Astro.url.search, Astro.url.origin).toString();
const stats = siteStats();
const topTopics = tagCounts().slice(0, 7);
const admin = Astro.locals.admin;
const cur = (key: Nav) => (nav === key ? 'page' : undefined);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Signal Lab" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#7853cf" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Signal Lab" href="/feed.xml" />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="app" id="app">
      <aside class="sidebar" id="sidebar" aria-label="Site navigation">
        <a class="brand" href="/">
          <span class="brand-mark"><Radar size={20} stroke-width={2.4} /></span>
          <span><span class="brand-name">Signal <span>Lab</span></span><span class="brand-tag">Tools worth knowing</span></span>
        </a>

        <nav aria-label="Discover">
          <div class="nav-label">Discover</div>
          <a class="nav-item" href="/" aria-current={cur('home')}><House size={18} /> Home</a>
          <a class="nav-item" href="/browse" aria-current={cur('browse')}><LayoutGrid size={18} /> All tools <span class="nav-count">{stats.total}</span></a>
          <a class="nav-item" href="/browse?kind=gem" aria-current={cur('gems')}><Gem size={18} /> Gems <span class="nav-count">{stats.gems}</span></a>
          <a class="nav-item" href="/browse?kind=new" aria-current={cur('new')}><Sparkles size={18} /> New &amp; moving <span class="nav-count">{stats.fresh}</span></a>
        </nav>

        {topTopics.length > 0 && (
          <nav aria-label="Topics">
            <div class="nav-label">Topics</div>
            {topTopics.map(({ tag, count }) => (
              <a class="nav-item" href={`/browse?tag=${encodeURIComponent(tag)}`} aria-current={topic === tag ? 'page' : undefined}>
                <TopicIcon tag={tag} /> {topicLabel(tag)} <span class="nav-count">{count}</span>
              </a>
            ))}
            <a class="nav-item" href="/topics" aria-current={cur('topics')}><Tags size={18} /> All topics <span class="nav-count">{stats.topics}</span></a>
          </nav>
        )}

        <div class="sidebar-foot">
          {admin ? (
            <nav aria-label="Admin">
              <div class="nav-label">Admin</div>
              <a class="nav-item" href="/admin" aria-current={cur('admin')}><Inbox size={18} /> Review queue {stats.pending > 0 && <span class="nav-count attention">{stats.pending}</span>}</a>
            </nav>
          ) : (
            <div class="sidebar-card">
              <strong><Compass size={14} /> How it works</strong>
              <p>Tools are found by a scanner and reviewed by a human before they appear here.</p>
              <a class="see-all small" href="/about">Learn more <ChevronRight size={14} /></a>
            </div>
          )}
          <a class="nav-item" href="/about" aria-current={cur('about')}><Info size={18} /> About</a>
          <a class="nav-item" href="/feed.xml"><Rss size={18} /> RSS feed</a>
        </div>
      </aside>
      <div class="backdrop" data-close-nav></div>

      <div class="main">
        <header class="topbar">
          <button class="icon-btn menu-btn" type="button" data-open-nav aria-label="Open navigation" aria-controls="sidebar"><Menu size={20} /></button>
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Signal Lab</a>
            {crumbs.map((c, i) => (
              <>
                <ChevronRight size={14} />
                {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </>
            ))}
          </nav>
          <div class="topbar-actions">
            <form class="search" action="/browse" role="search">
              <Search size={16} />
              <label class="visually-hidden" for="site-search">Search tools</label>
              <input id="site-search" type="search" name="q" placeholder="Search tools, topics, alternatives…" value={query} autocomplete="off" />
              <kbd title="Press / to search">/</kbd>
            </form>
            <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
              <Sun size={18} class="icon-sun" /><Moon size={18} class="icon-moon" />
            </button>
            {!admin && <a class="icon-btn" href="/admin" aria-label="Admin sign in" title="Admin"><Lock size={17} /></a>}
          </div>
        </header>

        <main class="content" id="content">
          <slot />
        </main>

        <footer class="site-footer">
          <span>© {new Date().getUTCFullYear()} Signal Lab · The tools you’d hear about from a good teammate.</span>
          <nav aria-label="Footer">
            <a href="/browse">Browse</a>
            <a href="/topics">Topics</a>
            <a href="/about">About</a>
            <a href="/feed.xml">RSS</a>
          </nav>
        </footer>
      </div>
    </div>

    <script>
      const app = document.getElementById('app')!;
      const setNav = (open: boolean) => app.classList.toggle('nav-open', open);
      document.querySelector('[data-open-nav]')?.addEventListener('click', () => setNav(true));
      document.querySelector('[data-close-nav]')?.addEventListener('click', () => setNav(false));

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch { /* private mode */ }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setNav(false);
        const t = e.target as HTMLElement;
        if (e.key === '/' && !e.metaKey && !e.ctrlKey && !['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName) && !t.isContentEditable) {
          e.preventDefault();
          (document.getElementById('site-search') as HTMLInputElement | null)?.focus();
        }
      });

      for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        btn.addEventListener('click', async () => {
          const text = btn.closest('.code')?.querySelector('pre')?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(text);
            btn.classList.add('copied');
            const label = btn.querySelector('[data-copy-label]');
            if (label) label.textContent = 'Copied';
            setTimeout(() => { btn.classList.remove('copied'); if (label) label.textContent = 'Copy'; }, 1800);
          } catch { /* clipboard blocked */ }
        });
      }

      for (const el of document.querySelectorAll<HTMLSelectElement>('select[data-autosubmit]')) {
        el.addEventListener('change', () => el.form?.requestSubmit());
      }
    </script>
  </body>
</html>
