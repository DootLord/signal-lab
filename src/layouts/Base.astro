---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { siteStats, tagCounts } from '../lib/db.ts';
import { topicLabel } from '../lib/format.ts';
import { SITE_NAME, abs, jsonLd, topicPath } from '../lib/site.ts';
import BrandMark from '../components/BrandMark.astro';
import {
  ChevronRight, Gem, House, Inbox, Info, LayoutGrid, Lock, Menu, Moon, Rss, Search, Sun, TrendingUp,
} from '../components/icons.ts';

export type Nav = 'home' | 'browse' | 'gems' | 'new' | 'topics' | 'about' | 'admin' | 'none';
interface Props {
  title?: string;
  /** Use this exact <title> instead of "title · Signal Lab". */
  fullTitle?: string;
  description?: string;
  nav?: Nav;
  topic?: string;
  crumbs?: { label: string; href?: string }[];
  query?: string;
  /** Site path of the canonical URL. Defaults to the current path without its query string. */
  canonical?: string;
  /** Keep the page out of search results (search results, admin, thin pages). */
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Structured data for the page, as a JSON-LD object or @graph items. */
  schema?: Record<string, unknown>[];
}
const {
  title, description = 'Discover developer tools worth knowing: what’s new and moving, and the established gems you may have missed. Every tool reviewed by hand.',
  nav = 'none', topic, crumbs = [], query = '', canonical: canonicalPath, noindex = false, ogType = 'website', schema = [],
} = Astro.props;
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: developer tools worth knowing, new and overlooked`);
const canonical = abs(canonicalPath ?? Astro.url.pathname);
const ogImage = abs('/og.png');
const robots = noindex || Astro.url.pathname.startsWith('/admin') ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
const structured = schema.length ? jsonLd({ '@context': 'https://schema.org', '@graph': schema }) : '';
const stats = siteStats();
const topTopics = tagCounts().slice(0, 7);
const admin = Astro.locals.admin;
const cur = (key: Nav) => (nav === key ? 'page' : undefined);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Signal Lab: developer tools worth knowing" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f5f5f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111213" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Signal Lab: new developer tools" href={abs('/feed.xml')} />
    {structured && <script type="application/ld+json" set:html={structured} />}
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="app" id="app">
      <aside class="sidebar" id="sidebar" aria-label="Site navigation">
        <a class="brand" href="/">
          <BrandMark />
          <span><span class="brand-name">Signal Lab</span><span class="brand-tag">Tools worth knowing</span></span>
        </a>

        <nav aria-label="Discover">
          <div class="nav-label">Discover</div>
          <a class="nav-item" href="/" aria-current={cur('home')}><House size={18} /> Home</a>
          <a class="nav-item" href="/browse" aria-current={cur('browse')}><LayoutGrid size={18} /> All tools <span class="nav-count">{stats.total}</span></a>
          <a class="nav-item" href="/browse?kind=gem" aria-current={cur('gems')}><Gem size={18} /> Gems <span class="nav-count">{stats.gems}</span></a>
          <a class="nav-item" href="/browse?kind=new" aria-current={cur('new')}><TrendingUp size={18} /> New &amp; moving <span class="nav-count">{stats.fresh}</span></a>
        </nav>

        {topTopics.length > 0 && (
          <nav aria-label="Topics">
            <div class="nav-label">Topics</div>
            {topTopics.map(({ tag, count }) => (
              <a class="nav-item" href={topicPath(tag)} aria-current={topic === tag ? 'page' : undefined}>
                {topicLabel(tag)} <span class="nav-count">{count}</span>
              </a>
            ))}
            <a class="nav-item" href="/topics" aria-current={cur('topics')}>All topics <span class="nav-count">{stats.topics}</span></a>
          </nav>
        )}

        <div class="sidebar-foot">
          {admin ? (
            <nav aria-label="Admin">
              <div class="nav-label">Admin</div>
              <a class="nav-item" href="/admin" aria-current={cur('admin')}><Inbox size={18} /> Review queue {stats.pending > 0 && <span class="nav-count attention">{stats.pending}</span>}</a>
            </nav>
          ) : (
            <p class="sidebar-note">Every tool here was checked by a person before it was published. <a href="/about">How tools are chosen</a></p>
          )}
          <a class="nav-item" href="/about" aria-current={cur('about')}><Info size={18} /> About</a>
          <a class="nav-item" href="/feed.xml"><Rss size={18} /> RSS feed</a>
        </div>
      </aside>
      <div class="backdrop" data-close-nav></div>

      <div class="main">
        <header class="topbar">
          <button class="icon-btn menu-btn" type="button" data-open-nav aria-label="Open navigation" aria-controls="sidebar"><Menu size={20} /></button>
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Signal Lab</a>
            {crumbs.map((c, i) => (
              <>
                <ChevronRight size={14} />
                {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </>
            ))}
          </nav>
          <div class="topbar-actions">
            <form class="search" action="/browse" role="search">
              <Search size={16} />
              <label class="visually-hidden" for="site-search">Search tools</label>
              <input id="site-search" type="search" name="q" placeholder="Search tools, topics, alternatives…" value={query} autocomplete="off" />
              <kbd title="Press / to search">/</kbd>
            </form>
            <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
              <Sun size={18} class="icon-sun" /><Moon size={18} class="icon-moon" />
            </button>
            {!admin && <a class="icon-btn" href="/admin" aria-label="Admin sign in" title="Admin"><Lock size={17} /></a>}
          </div>
        </header>

        <main class="content" id="content">
          <slot />
        </main>

        <footer class="site-footer">
          <span class="footer-credit">
            © {new Date().getUTCFullYear()} Signal Lab. Made by
            <a class="made-by" href="https://dootlord.meme" rel="author"><img src="/dootlord.png" alt="" width="22" height="22" loading="lazy" />DootLord</a>
          </span>
          <nav aria-label="Footer">
            <a href="/browse">Browse</a>
            <a href="/topics">Topics</a>
            <a href="/about">About</a>
            <a href="/feed.xml">RSS</a>
          </nav>
        </footer>
      </div>
    </div>

    <script>
      const app = document.getElementById('app')!;
      const setNav = (open: boolean) => app.classList.toggle('nav-open', open);
      document.querySelector('[data-open-nav]')?.addEventListener('click', () => setNav(true));
      document.querySelector('[data-close-nav]')?.addEventListener('click', () => setNav(false));

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch { /* private mode */ }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setNav(false);
        const t = e.target as HTMLElement;
        if (e.key === '/' && !e.metaKey && !e.ctrlKey && !['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName) && !t.isContentEditable) {
          e.preventDefault();
          (document.getElementById('site-search') as HTMLInputElement | null)?.focus();
        }
      });

      for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        btn.addEventListener('click', async () => {
          const text = btn.closest('.code')?.querySelector('pre')?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(text);
            btn.classList.add('copied');
            const label = btn.querySelector('[data-copy-label]');
            if (label) label.textContent = 'Copied';
            setTimeout(() => { btn.classList.remove('copied'); if (label) label.textContent = 'Copy'; }, 1800);
          } catch { /* clipboard blocked */ }
        });
      }

      for (const el of document.querySelectorAll<HTMLSelectElement>('select[data-autosubmit]')) {
        el.addEventListener('change', () => el.form?.requestSubmit());
      }
    </script>
  </body>
</html>
