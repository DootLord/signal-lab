---
import type { ToolInput } from '../lib/db.ts';
import { CircleAlert } from './icons.ts';

interface Props { value?: Partial<ToolInput>; errors?: string[]; submitLabel: string; cancelHref?: string; }
const { value = {}, errors = [], submitLabel, cancelHref = '/admin' } = Astro.props;
---
<form method="post" class="panel">
  <input type="hidden" name="_action" value="save" />
  {errors.length > 0 && (
    <div style="padding:20px 24px 0">
      <div class="alert error" role="alert"><CircleAlert size={16} /><ul>{errors.map((e) => <li>{e}</li>)}</ul></div>
    </div>
  )}
  <div class="form-section">
    <h3>Basics</h3>
    <div class="form-grid">
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required maxlength="80" value={value.name ?? ''} />
      </div>
      <div class="field">
        <label for="kind">Type</label>
        <select id="kind" name="kind">
          <option value="gem" selected={value.kind !== 'new'}>Gem: established but often missed</option>
          <option value="new" selected={value.kind === 'new'}>New: recent or gaining momentum</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="tagline">Tagline <span class="hint">· one sentence: what is it?</span></label>
      <input id="tagline" name="tagline" type="text" required maxlength="200" value={value.tagline ?? ''} />
    </div>
    <div class="field">
      <label for="description">Description <span class="hint">· what it does and why it’s good</span></label>
      <textarea id="description" name="description" required maxlength="2000">{value.description ?? ''}</textarea>
    </div>
    <div class="field" style="margin-bottom:0">
      <label for="tags">Topics <span class="hint">· comma separated, e.g. python, testing, cli</span></label>
      <input id="tags" name="tags" type="text" maxlength="300" value={(value.tags ?? []).join(', ')} />
    </div>
  </div>
  <div class="form-section">
    <h3>Practical details</h3>
    <div class="form-grid">
      <div class="field">
        <label for="replaces">Instead of <span class="hint">· what people use today</span></label>
        <textarea id="replaces" name="replaces" maxlength="300" rows="3" style="min-height:0">{value.replaces ?? ''}</textarea>
      </div>
      <div class="field">
        <label for="useWhen">Reach for it when</label>
        <textarea id="useWhen" name="useWhen" maxlength="600" rows="3" style="min-height:0">{value.useWhen ?? ''}</textarea>
      </div>
    </div>
    <div class="field" style="margin-bottom:0">
      <label for="tryIt">Try it <span class="hint">· commands to get going; lines starting with # are shown as comments</span></label>
      <textarea id="tryIt" name="tryIt" class="mono" maxlength="1500">{value.tryIt ?? ''}</textarea>
    </div>
  </div>
  <div class="form-section">
    <h3>In depth</h3>
    <div class="field">
      <label for="features">Key features <span class="hint">· one per line, as “Title: what it does”</span></label>
      <textarea id="features" name="features" maxlength="3000" rows="6">{value.features ?? ''}</textarea>
    </div>
    <div class="field">
      <label for="body">Write-up <span class="hint">· how it works, workflows, examples. Supports ### headings, lists, ``` code blocks, `code`, **bold**, [links](https://…)</span></label>
      <textarea id="body" name="body" class="mono" maxlength="12000" rows="16">{value.body ?? ''}</textarea>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="strengths">Strengths <span class="hint">· one per line</span></label>
        <textarea id="strengths" name="strengths" maxlength="2000" rows="5">{value.strengths ?? ''}</textarea>
      </div>
      <div class="field">
        <label for="limitations">Watch out for <span class="hint">· one per line</span></label>
        <textarea id="limitations" name="limitations" maxlength="2000" rows="5">{value.limitations ?? ''}</textarea>
      </div>
    </div>
    <div class="field">
      <label for="alternatives">Alternatives <span class="hint">· one per line, as “Name: how it compares”</span></label>
      <textarea id="alternatives" name="alternatives" maxlength="2000" rows="4">{value.alternatives ?? ''}</textarea>
    </div>
    <div class="form-grid">
      <div class="field" style="margin-bottom:0"><label for="license">License</label><input id="license" name="license" type="text" maxlength="60" placeholder="e.g. MIT" value={value.license ?? ''} /></div>
      <div class="field" style="margin-bottom:0"><label for="language">Written in</label><input id="language" name="language" type="text" maxlength="60" placeholder="e.g. Rust" value={value.language ?? ''} /></div>
    </div>
  </div>
  <div class="form-section">
    <h3>Links</h3>
    <div class="form-grid">
      <div class="field"><label for="website">Website</label><input id="website" name="website" type="url" placeholder="https://" value={value.website ?? ''} /></div>
      <div class="field"><label for="repo">Repository</label><input id="repo" name="repo" type="url" placeholder="https://github.com/…" value={value.repo ?? ''} /></div>
      <div class="field"><label for="docs">Docs</label><input id="docs" name="docs" type="url" placeholder="https://" value={value.docs ?? ''} /></div>
    </div>
  </div>
  <div class="form-actions">
    <a class="btn ghost" href={cancelHref}>Cancel</a>
    <button class="btn primary" type="submit">{submitLabel}</button>
  </div>
</form>
