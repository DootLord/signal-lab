---
import type { Tool } from '../lib/db.ts';
import { timeAgo } from '../lib/format.ts';
import KindBadge from './KindBadge.astro';
import Monogram from './Monogram.astro';
import { ChevronRight } from './icons.ts';

interface Props { tool: Tool; }
const { tool } = Astro.props;
---
<article class="row">
  <Monogram name={tool.name} size={36} />
  <div class="row-main">
    <h3><a href={`/tools/${tool.slug}`}>{tool.name}</a> <KindBadge kind={tool.kind} /></h3>
    <p>{tool.tagline}</p>
  </div>
  <span class="row-meta">Added {timeAgo(tool.publishedAt ?? tool.createdAt)}</span>
  <ChevronRight size={18} class="muted" />
</article>
