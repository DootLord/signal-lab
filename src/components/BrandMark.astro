---
// The Signal Lab mark: a signal trace, drawn in ink on signal yellow. Same drawing as public/favicon.svg.
interface Props { size?: number; }
const { size = 18 } = Astro.props;
---
<span class="brand-mark" aria-hidden="true">
  <svg width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 26h8l5-14 9 24 5-14h11" />
  </svg>
</span>
