---
import type { Tool } from '../lib/db.ts';
import KindBadge from './KindBadge.astro';

interface Props { tool: Tool; }
const { tool } = Astro.props;
---
<article class="card">
  <h3><a href={`/tools/${tool.slug}`}>{tool.name}</a> <KindBadge kind={tool.kind} /></h3>
  <p>{tool.tagline}</p>
  {tool.replaces && <p class="replaces">Instead of: {tool.replaces}</p>}
  <div class="tags">
    {tool.tags.slice(0, 4).map((tag) => <a class="tag" href={`/browse?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
  </div>
</article>
